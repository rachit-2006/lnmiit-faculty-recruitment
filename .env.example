# LNMIIT Faculty Recruitment Workflow Management System - Environment Configuration
# Copy this file to .env to customize local or production settings

# Server port (default: 3000)
PORT=3000

# Node environment (development | test | production)
NODE_ENV=development

# Session Configuration
SESSION_EXPIRY_HOURS=12

# File Upload and Storage Constraints
MAX_FILE_SIZE_MB=2
ALLOWED_FILE_EXTENSIONS=pdf,jpg,jpeg,png

# File Storage Directories
DATA_DIR=data
STORAGE_DIR=storage/documents

# Database Persistence Option
# Engine default is 'json' (atomic file persistence at data/database.json).
# For PostgreSQL / MongoDB enterprise deployments, set DB_ENGINE:
DB_ENGINE=json

# PostgreSQL Database Configuration (when DB_ENGINE=postgres)
PGHOST=localhost
PGPORT=5432
PGDATABASE=lnmiit_recruitment
PGUSER=postgres
PGPASSWORD=your_secure_password

# MongoDB Database Configuration (when DB_ENGINE=mongodb)
MONGODB_URI=mongodb://localhost:27017/lnmiit_recruitment
